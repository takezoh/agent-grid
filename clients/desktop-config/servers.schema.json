{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Grid desktop servers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "servers"],
  "properties": {
    "schema_version": { "const": 1 },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["display_name", "enabled", "url", "token_path"],
        "properties": {
          "id": {
            "type": "string",
            "deprecated": true,
            "description": "Ignored read-only compatibility field; clients derive the identifier from url."
          },
          "display_name": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "url": { "type": "string", "format": "uri" },
          "token_path": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
