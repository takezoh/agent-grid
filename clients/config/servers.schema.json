{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Grid desktop servers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "servers"],
  "properties": {
    "schema_version": { "const": 2 },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["display_name", "enabled", "url", "auth"],
        "properties": {
          "id": {
            "type": "string",
            "deprecated": true,
            "description": "Ignored read-only compatibility field; clients derive the identifier from url."
          },
          "display_name": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "default_execution": {
            "type": "boolean",
            "description": "Marks the enabled server selected by default for new sessions. Older files without this field use the first enabled entry until saved."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://"
          },
          "auth": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode"],
                "properties": {
                  "mode": { "const": "none" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "token"],
                "properties": {
                  "mode": { "const": "bearer" },
                  "token": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
