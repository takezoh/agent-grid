{
  "name": "agent-grid-workspace",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "main": "dist/main/electron-entry.js",
  "scripts": {
    "check:github-oauth": "node ../config/generate-github-oauth.mjs --check",
    "prebuild": "npm run check:github-oauth",
    "build": "npm --prefix ../ui run build && tsc -p tsconfig.json && node scripts/copy-ui.mjs",
    "pretypecheck": "npm run check:github-oauth",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run check:github-oauth",
    "test": "vitest --run",
    "test:unit": "vitest --run",
    "lint:browserwindow": "node scripts/check-browserwindow.mjs",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "electron": "43.2.0",
    "happy-dom": "20.10.6",
    "typescript": "5.7.2",
    "vitest": "4.1.10"
  }
}
